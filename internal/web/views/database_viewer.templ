package views

import "strconv"

templ DatabasesPage(assets Assets, data DatabaseListData) {
	@Layout("Databases | sqlwise", assets) {
		<main class="mx-auto min-h-screen w-full max-w-3xl px-4 py-10 sm:px-8">
			<nav aria-label="Breadcrumb" class="text-sm"><a href="/account" class="text-cyan-300 underline underline-offset-4">Account</a></nav>
			<h1 class="mt-6 text-3xl font-semibold tracking-tight">Databases</h1>
			<p class="mt-3 text-sm text-slate-400">Signed in as <strong class="text-slate-200">{ data.Username }</strong>. Only databases your groups can view are listed.</p>
			if len(data.Databases) == 0 {
				<p class="mt-6 text-sm text-slate-400">No database access has been assigned to your account.</p>
			}
			<ul class="mt-6 divide-y divide-slate-800 rounded-2xl border border-slate-800 bg-slate-900 px-5">
				for _, db := range data.Databases {
					<li class="flex flex-wrap items-center justify-between gap-3 py-4">
						<a href={ templ.SafeURL(databaseURL(db.ID)) } class="break-all text-sm font-medium text-cyan-300 underline underline-offset-4">{ db.Name }</a>
						<span class="rounded-lg border border-slate-700 px-3 py-2 text-sm text-slate-300">{ db.Permission }</span>
					</li>
				}
			</ul>
		</main>
	}
}

templ SchemaExplorer(assets Assets, data SchemaExplorerData) {
	@DatabaseShell("Schema", assets, data.Nav) {
		<form method="get" action={ templ.SafeURL(databaseURL(data.Nav.ID)) } hx-get={ templ.SafeURL(databaseURL(data.Nav.ID)) } hx-target="#schema-explorer" hx-swap="innerHTML" hx-push-url="true" hx-trigger="change" class="flex flex-wrap items-end gap-3">
			<div class="space-y-2">
				<label for="schema" class="block text-sm font-medium text-slate-200">Schema</label>
				<select id="schema" name="schema" class="min-h-12 rounded-lg border border-slate-700 bg-slate-950 px-3 text-base text-slate-100">
					for _, schema := range data.Schemas {
						<option value={ schema } selected?={ schema == data.Schema }>{ schema }</option>
					}
				</select>
			</div>
			<noscript><button type="submit" class="min-h-12 rounded-lg border border-slate-700 px-4 text-sm text-slate-200">Show</button></noscript>
		</form>
		<div id="schema-explorer" class="mt-6">
			@SchemaExplorerFragment(data)
		</div>
	}
}

templ SchemaExplorerFragment(data SchemaExplorerData) {
	<h2 class="text-xl font-semibold">Tables in { data.Schema }</h2>
	if len(data.Tables) == 0 {
		<p class="mt-3 text-sm text-slate-400">This schema has no tables.</p>
	}
	<div class="mt-4 space-y-3">
		for _, table := range data.Tables {
			<details class="rounded-2xl border border-slate-800 bg-slate-900 p-4">
				<summary class="flex cursor-pointer flex-wrap items-center justify-between gap-3">
					<span class="break-all font-medium text-slate-100">{ table.Name }</span>
					<span class="text-sm text-slate-400">{ strconv.Itoa(len(table.Columns)) } columns</span>
				</summary>
				<div class="mt-4 overflow-x-auto">
					<table class="w-full text-left text-sm">
						<thead class="text-slate-400"><tr><th scope="col" class="py-2 pr-4 font-medium">Column</th><th scope="col" class="py-2 pr-4 font-medium">Type</th><th scope="col" class="py-2 pr-4 font-medium">Nullable</th><th scope="col" class="py-2 font-medium">Default</th></tr></thead>
						<tbody class="divide-y divide-slate-800">
							for _, column := range table.Columns {
								<tr>
									<td class="break-all py-2 pr-4 text-slate-100">
										{ column.Name }
										if column.PrimaryKey {
											<span class="ml-2 rounded bg-slate-800 px-1.5 py-0.5 text-xs text-cyan-300">PK</span>
										}
									</td>
									<td class="py-2 pr-4 font-mono text-slate-300">{ column.Type }</td>
									<td class="py-2 pr-4 text-slate-300">
										if column.Nullable {
											yes
										} else {
											no
										}
									</td>
									<td class="break-all py-2 font-mono text-slate-300">
										if column.HasDefault {
											{ column.Default }
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				@definitionList("Constraints", table.Constraints)
				@definitionList("Indexes", table.Indexes)
				<a href={ templ.SafeURL(TableURL(data.Nav.ID, table.ID, 0, 50)) } class="mt-4 inline-flex min-h-11 items-center rounded-lg border border-cyan-900 px-4 text-sm text-cyan-300">View data</a>
			</details>
		}
	</div>
}

templ definitionList(title string, definitions []SchemaDefinition) {
	if len(definitions) > 0 {
		<h3 class="mt-4 text-sm font-semibold text-slate-200">{ title }</h3>
		<ul class="mt-2 space-y-1 text-sm">
			for _, d := range definitions {
				<li class="break-all text-slate-300"><span class="text-slate-100">{ d.Name }</span> <span class="text-slate-400">{ d.Kind }</span> <code class="font-mono text-slate-300">{ d.Definition }</code></li>
			}
		</ul>
	}
}

templ TableData(assets Assets, data TablePageData) {
	@DatabaseShell(data.Table, assets, data.Nav) {
		<a href={ templ.SafeURL(schemaURL(data.Nav.ID, data.Schema)) } class="text-sm text-cyan-300 underline underline-offset-4">{ data.Schema }</a>
		<h1 class="mt-2 break-all text-2xl font-semibold tracking-tight">{ data.Table }</h1>
		<div id="table-page" class="mt-6">
			@TablePageFragment(data)
		</div>
	}
}

templ TablePageFragment(data TablePageData) {
	if !data.Ordered {
		<p role="status" class="mb-4 rounded-lg border border-slate-800 bg-slate-900 p-3 text-sm text-slate-300">This table has no primary key, so rows may appear in a different order on each page.</p>
	}
	if data.Truncated {
		<p role="status" class="mb-4 rounded-lg border border-slate-800 bg-slate-900 p-3 text-sm text-slate-300">This page was shortened to stay within the response size limit.</p>
	}
	<div class="overflow-x-auto rounded-2xl border border-slate-800">
		<table class="w-full text-left text-sm">
			<thead class="bg-slate-900 text-slate-400">
				<tr>
					for _, column := range data.Columns {
						<th scope="col" class="whitespace-nowrap px-3 py-2 font-medium"><span class="text-slate-100">{ column.Name }</span> <span class="font-mono text-xs">{ column.Type }</span></th>
					}
				</tr>
			</thead>
			<tbody class="divide-y divide-slate-800">
				for _, row := range data.Rows {
					<tr>
						for _, cell := range row {
							<td class="max-w-md break-all px-3 py-2 align-top">
								if cell.Null {
									<span class="italic text-slate-500">NULL</span>
								} else if cell.Binary {
									<span class="font-mono text-slate-300">{ cell.Text }</span>
								} else {
									<span class="whitespace-pre-wrap text-slate-200">{ cell.Text }</span>
								}
								if cell.Truncated {
									<span class="ml-1 text-xs text-cyan-300">… truncated</span>
								}
							</td>
						}
					</tr>
				}
			</tbody>
		</table>
	</div>
	if len(data.Rows) == 0 {
		<p class="mt-4 text-sm text-slate-400">No rows on this page.</p>
	}
	<nav aria-label="Pages" class="mt-4 flex flex-wrap items-center justify-between gap-3 text-sm">
		if len(data.Rows) > 0 {
			<span class="text-slate-400">Rows { strconv.Itoa(data.From) }–{ strconv.Itoa(data.To) }</span>
		} else {
			<span></span>
		}
		<span class="flex gap-2">
			if data.PrevURL != "" {
				<a href={ templ.SafeURL(data.PrevURL) } hx-get={ templ.SafeURL(data.PrevURL) } hx-target="#table-page" hx-swap="innerHTML" hx-push-url="true" class="inline-flex min-h-11 items-center rounded-lg border border-slate-700 px-4 text-slate-200">Previous</a>
			}
			if data.NextURL != "" {
				<a href={ templ.SafeURL(data.NextURL) } hx-get={ templ.SafeURL(data.NextURL) } hx-target="#table-page" hx-swap="innerHTML" hx-push-url="true" class="inline-flex min-h-11 items-center rounded-lg border border-slate-700 px-4 text-slate-200">Next</a>
			}
		</span>
	</nav>
}
