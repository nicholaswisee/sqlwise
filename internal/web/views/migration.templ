package views

templ DatabaseShell(title string, assets Assets, nav DatabaseNav) {
	@Layout(title+" | "+nav.Name+" | sqlwise", assets) {
		<div class={ wsPage + " flex flex-col" }>
			@WorkspaceTopbar(nav.Username) {
				<nav aria-label="Breadcrumb" class="flex min-w-0 flex-wrap items-center gap-2 text-sm text-slate-600">
					<a href="/databases" class={ "inline-flex min-h-11 items-center text-slate-700 hover:text-cyan-800 " + wsFocus }>Databases</a>
					<span aria-hidden="true">/</span>
					<span class="break-all font-medium text-slate-900">{ nav.Name }</span>
				</nav>
			}
			<section aria-label="Database" class="border-b border-slate-200 bg-white">
				<div class="mx-auto flex w-full max-w-7xl flex-wrap items-end justify-between gap-x-10 gap-y-5 px-4 pt-6 sm:px-6">
					<div class="flex min-w-0 flex-wrap items-center gap-2.5">
						<p class="break-all text-2xl font-semibold tracking-tight text-slate-900">{ nav.Name }</p>
						if nav.Engine != "" {
							<span class={ wsChip }>{ nav.Engine }</span>
						}
						if nav.CanEdit {
							<span class={ wsChipTeal }>View + Edit</span>
						} else {
							<span class={ wsChip }>View only</span>
						}
					</div>
					@versionTrack(nav)
				</div>
				<nav aria-label="Database sections" class="mx-auto mt-3 flex w-full max-w-7xl flex-wrap gap-1 px-4 sm:px-6">
					@sectionTab("Schema", databaseURL(nav.ID), nav.Active == "schema")
					@sectionTab("Migrations", migrationsURL(nav.ID), nav.Active == "migrations")
					@sectionTab("Schema diff", schemaDiffURL(nav.ID), nav.Active == "schema-diff")
				</nav>
			</section>
			<main class="mx-auto w-full max-w-7xl flex-1 px-4 py-8 sm:px-6">
				{ children... }
			</main>
		</div>
	}
}

// WorkspaceTopbar is the light workspace header; children hold breadcrumbs.
templ WorkspaceTopbar(username string) {
	<header class="border-b border-slate-200 bg-white">
		<div class="mx-auto flex w-full max-w-7xl flex-wrap items-center gap-x-6 gap-y-1 px-4 py-1.5 sm:px-6">
			<a href="/databases" class={ "inline-flex min-h-11 items-center gap-2 text-base font-bold tracking-tight text-cyan-900 " + wsFocus }>
				<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><ellipse cx="12" cy="6" rx="7" ry="3"></ellipse><path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6"></path><path d="M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"></path></svg>
				sqlwise
			</a>
			{ children... }
			<a href="/account" class={ "ml-auto inline-flex min-h-11 items-center gap-2 text-sm text-slate-700 hover:text-cyan-800 " + wsFocus }>
				<span aria-hidden="true" class="inline-flex size-8 items-center justify-center rounded-full bg-cyan-700 text-xs font-semibold text-white">{ initials(username) }</span>
				<span>Signed in as <strong class="font-semibold text-slate-900">{ username }</strong></span>
			</a>
		</div>
	</header>
}

templ versionTrack(nav DatabaseNav) {
	<nav aria-label="Version history" class="max-w-full overflow-x-auto pb-1">
		if len(nav.Track) == 0 {
			<p class="pb-2 text-sm text-slate-600">No migrations yet</p>
		} else {
			<ol class="flex items-start">
				if nav.TrackEarlier > 0 {
					<li class="mr-1 self-start pt-0.5 text-xs text-slate-600">+{ itoa64(int64(nav.TrackEarlier)) } earlier</li>
				}
				for i, stop := range nav.Track {
					<li class="relative flex w-20 shrink-0 flex-col items-center">
						if i > 0 {
							<span aria-hidden="true" class="absolute right-1/2 top-[7px] h-0.5 w-full bg-cyan-200"></span>
						}
						<a href={ templ.SafeURL(stop.Href) } aria-label={ stop.Aria } class={ "flex flex-col items-center gap-1.5 rounded-md px-1 pb-1 text-xs text-slate-700 hover:text-cyan-900 " + wsFocus }>
							<span class={ trackDotClass(stop.State) }></span>
							if stop.State == "current" || stop.State == "draft" {
								<span class="font-mono font-semibold text-slate-900">{ stop.Label }</span>
							} else {
								<span class="font-mono">{ stop.Label }</span>
							}
							if stop.Note != "" {
								<span class={ trackNoteClass(stop.NoteTone) }>{ stop.Note }</span>
							}
						</a>
					</li>
				}
			</ol>
		}
	</nav>
}

templ sectionTab(label, href string, active bool) {
	if active {
		<a href={ templ.SafeURL(href) } aria-current="page" class={ "-mb-px inline-flex min-h-11 items-center border-b-2 border-cyan-700 px-3 text-sm font-semibold text-cyan-900 " + wsFocus }>{ label }</a>
	} else {
		<a href={ templ.SafeURL(href) } class={ "-mb-px inline-flex min-h-11 items-center border-b-2 border-transparent px-3 text-sm text-slate-600 hover:border-slate-300 hover:text-slate-900 " + wsFocus }>{ label }</a>
	}
}

templ alert(message string) {
	if message != "" {
		<p role="alert" class={ wsAlert + " break-words" }>{ message }</p>
	}
}

templ notice(message string) {
	if message != "" {
		<p role="status" class={ wsNotice + " break-words" }>{ message }</p>
	}
}

templ statusBadge(status string) {
	<span class={ statusClass(status) }>{ statusLabel(status) }</span>
}

templ sqlBlock(sql string) {
	<pre class={ wsCode }><code>{ sql }</code></pre>
}

templ sqlField(id, value string, readonly bool) {
	<textarea id={ id } name="sql" rows="14" required spellcheck="false" autocapitalize="none" maxlength="262144" readonly?={ readonly } class={ wsTextarea }>{ value }</textarea>
}

const primaryButton = wsPrimary

const inputClass = wsInput

templ MigrationHistory(assets Assets, data MigrationHistoryData) {
	@DatabaseShell("Migrations", assets, data.Nav) {
		<div>
			<h1 class={ wsHeading }>Migrations</h1>
			<p class={ wsMuted + " mt-1" }>Current applied version: <strong class="font-mono font-semibold text-slate-900">{ version(data.CurrentVersion) }</strong></p>
		</div>
		if data.Error != "" {
			<div class="mt-6">
				@alert(data.Error)
			</div>
		}
		<div class="mt-6 flex flex-wrap items-start gap-6">
			if data.Nav.CanEdit {
				<section aria-labelledby="new-heading" class={ wsPanel + " min-w-0 flex-[999_1_560px] p-5 sm:p-6" }>
					<h2 id="new-heading" class={ wsSubhead }>New migration</h2>
					<p class={ wsMuted + " mt-1 leading-6" }>Saving creates a draft. Nothing runs until you review and execute it.</p>
					<form method="post" action={ templ.SafeURL(migrationsURL(data.Nav.ID)) } class="mt-5 space-y-4">
						<input type="hidden" name="csrf_token" value={ data.Nav.CSRFToken }/>
						<div class="space-y-1.5"><label for="new-title" class={ wsLabel }>Title</label><input id="new-title" name="title" type="text" required maxlength="200" value={ data.Form.Title } class={ inputClass }/></div>
						<div class="space-y-1.5"><label for="new-sql" class={ wsLabel }>SQL</label>@sqlField("new-sql", data.Form.SQL, false)</div>
						<button type="submit" class={ primaryButton }>Save draft</button>
					</form>
				</section>
			}
			<section aria-labelledby="drafts-heading" class="min-w-0 flex-[1_1_360px]">
				<h2 id="drafts-heading" class={ wsSubhead }>Drafts</h2>
				if len(data.Drafts) == 0 {
					<p class={ wsEmpty + " mt-3" }>No migrations yet.</p>
				} else {
					<ul class={ wsPanel + " mt-3 divide-y divide-slate-100" }>
						for _, d := range data.Drafts {
							<li class="flex flex-wrap items-start justify-between gap-x-3 gap-y-2 px-4 py-3">
								<div class="min-w-0">
									<a href={ templ.SafeURL(migrationURL(data.Nav.ID, d.ID)) } class={ wsLink + " break-words font-medium" }>{ d.Title }</a>
									<p class="mt-1 text-xs leading-5 text-slate-600">Revision { itoa64(d.Revision) } · updated { d.UpdatedAt } by { d.UpdatedBy }</p>
								</div>
								{{ label, class := draftState(d) }}
								<span class={ class }>{ label }</span>
							</li>
						}
					</ul>
				}
			</section>
		</div>
		<section aria-labelledby="history-heading" class="mt-10">
			<h2 id="history-heading" class={ wsSubhead }>Execution history</h2>
			<p class={ wsMuted + " mt-1" }>Every attempt is kept, newest first. Applied versions increase only on success.</p>
			@attemptTable(data.Nav.ID, data.Attempts, true)
		</section>
	}
}

templ attemptTable(databaseID string, attempts []MigrationAttemptRow, showMigration bool) {
	if len(attempts) == 0 {
		<p class={ wsEmpty + " mt-3" }>No executions yet.</p>
	} else {
		<div class={ wsPanel + " mt-3 overflow-x-auto" }>
			<table class={ wsTable + " min-w-[44rem]" }>
				<thead>
					<tr>
						<th scope="col" class={ wsTh }>Version</th>
						<th scope="col" class={ wsTh }>Status</th>
						if showMigration {
							<th scope="col" class={ wsTh }>Migration</th>
						}
						<th scope="col" class={ wsTh }>Executor</th>
						<th scope="col" class={ wsTh }>Started</th>
						<th scope="col" class={ wsTh }>Finished</th>
						<th scope="col" class={ wsTh }><span class="sr-only">Details</span></th>
					</tr>
				</thead>
				<tbody class="[&>tr:last-child>td]:border-b-0">
					for _, a := range attempts {
						<tr>
							<td class={ wsTd + " whitespace-nowrap font-mono text-slate-900" }>
								if a.AppliedVersion > 0 {
									{ version(a.AppliedVersion) }
								} else {
									<span class="text-slate-600">candidate { version(a.CandidateVersion) }</span>
								}
							</td>
							<td class={ wsTd }>
								@statusBadge(a.Status)
								if a.Error != "" {
									<p class="mt-1.5 max-w-md break-words text-xs leading-5 text-slate-600">{ a.Error }</p>
								}
							</td>
							if showMigration {
								<td class={ wsTd + " break-words" }><a href={ templ.SafeURL(migrationURL(databaseID, a.MigrationID)) } class={ wsLink }>{ a.MigrationTitle }</a></td>
							}
							<td class={ wsTd + " break-all text-slate-900" }>{ a.Executor }</td>
							<td class={ wsTd + " whitespace-nowrap font-mono text-slate-700" }>{ a.StartedAt }</td>
							<td class={ wsTd + " whitespace-nowrap font-mono text-slate-700" }>{ a.FinishedAt }</td>
							<td class={ wsTd + " whitespace-nowrap" }><a href={ templ.SafeURL(attemptURL(databaseID, a.MigrationID, a.ID)) } class={ wsLink }>SQL and details</a></td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ MigrationDetail(assets Assets, data MigrationDetailData) {
	@DatabaseShell(data.Draft.Title, assets, data.Nav) {
		<div class="flex flex-wrap items-start gap-6">
			<div class="min-w-0 flex-[999_1_560px] space-y-6">
				<div>
					<a href={ templ.SafeURL(migrationsURL(data.Nav.ID)) } class={ wsLink + " inline-flex min-h-11 items-center text-sm" }>All migrations</a>
					<h1 class={ wsHeading + " break-words" }>{ data.Draft.Title }</h1>
					<dl class="mt-3 grid gap-x-6 gap-y-1.5 text-sm text-slate-600 sm:grid-cols-2">
						<div><dt class="inline">Status: </dt><dd class="inline text-slate-900">
							if data.Draft.AppliedVersion > 0 {
								Applied as { version(data.Draft.AppliedVersion) } (read-only)
							} else {
								Draft revision { itoa64(data.Draft.Revision) }
							}
						</dd></div>
						<div><dt class="inline">Dialect: </dt><dd class="inline text-slate-900">{ data.Draft.Dialect }</dd></div>
						<div><dt class="inline">Created: </dt><dd class="inline text-slate-900">{ data.Draft.CreatedAt } by { data.Draft.CreatedBy }</dd></div>
						<div><dt class="inline">Updated: </dt><dd class="inline text-slate-900">{ data.Draft.UpdatedAt } by { data.Draft.UpdatedBy }</dd></div>
					</dl>
					if data.Notice != "" {
						<div class="mt-6">
							@notice(data.Notice)
						</div>
					}
					if data.Blocked != "" {
						<div class={ wsWarn + " mt-6 space-y-3" }>
							<p role="alert" class="text-base font-semibold leading-6">{ data.Blocked }</p>
							if data.ReconcileURL != "" {
								<form method="post" action={ templ.SafeURL(data.ReconcileURL) } class="space-y-3">
									<input type="hidden" name="csrf_token" value={ data.Nav.CSRFToken }/>
									<p>Check the target first: statements that ran before the failure stay applied. Then lift the block; the attempt stays in history.</p>
									<button type="submit" class={ wsWarnBtn + " py-2" }>I checked the target, mark as reconciled</button>
								</form>
							}
						</div>
					}
					<div id="execution-result" aria-live="polite">
						if data.Result != nil {
							@ExecutionResult(*data.Result)
						}
					</div>
				</div>
				if data.Nav.CanEdit && data.Draft.AppliedVersion == 0 {
					<section aria-labelledby="edit-heading" class={ wsPanel + " p-5 sm:p-6" }>
						<h2 id="edit-heading" class={ wsSubhead }>Edit SQL</h2>
						<form method="post" action={ templ.SafeURL(migrationURL(data.Nav.ID, data.Draft.ID)) } hx-patch={ migrationURL(data.Nav.ID, data.Draft.ID) } hx-target="#edit-result" hx-headers={ csrfHeaders(data.Nav.CSRFToken) } hx-disabled-elt="find button" hx-on::before-swap={ templ.JSUnsafeFuncCall(errorSwap) } class="mt-4 space-y-4">
							<input type="hidden" name="csrf_token" value={ data.Nav.CSRFToken }/>
							<input type="hidden" name="expected_revision" value={ itoa64(data.Draft.Revision) }/>
							<div class="space-y-1.5"><label for="edit-title" class={ wsLabel }>Title</label><input id="edit-title" name="title" type="text" required maxlength="200" value={ data.Form.Title } class={ inputClass }/></div>
							<div class="space-y-1.5"><label for="edit-sql" class={ wsLabel }>SQL</label>@sqlField("edit-sql", data.Form.SQL, false)</div>
							<div id="edit-result" aria-live="polite">@alert(data.EditError)</div>
							<button type="submit" class={ wsButton }>Save revision { itoa64(data.Draft.Revision + 1) }</button>
						</form>
					</section>
				} else {
					<section aria-labelledby="sql-heading" class={ wsPanel + " p-5 sm:p-6" }>
						<h2 id="sql-heading" class={ wsSubhead }>SQL</h2>
						<div class="mt-4">@sqlBlock(data.Draft.SQL)</div>
					</section>
				}
				if data.Nav.CanEdit && data.Draft.AppliedVersion == 0 {
					<section aria-labelledby="execute-heading" class={ wsPanel + " p-5 sm:p-6" }>
						<h2 id="execute-heading" class={ wsSubhead }>Execute</h2>
						if data.Draft.Dialect == "mysql" {
							<p class="mt-2 text-sm leading-6 text-slate-700">
								Runs saved revision { itoa64(data.Draft.Revision) } (SHA-256 <code class="font-mono text-slate-900">{ shortHash(data.Draft.SQLHash) }</code>) statement by statement as
								<strong class="font-mono font-semibold text-slate-900">{ version(data.CurrentVersion + 1) }</strong>. MySQL commits DDL immediately, so if a later statement fails the earlier ones stay applied. Unsaved edits above are not executed.
							</p>
						} else {
							<p class="mt-2 text-sm leading-6 text-slate-700">
								Runs saved revision { itoa64(data.Draft.Revision) } (SHA-256 <code class="font-mono text-slate-900">{ shortHash(data.Draft.SQLHash) }</code>) in one transaction as
								<strong class="font-mono font-semibold text-slate-900">{ version(data.CurrentVersion + 1) }</strong>. Any error rolls back every statement. Unsaved edits above are not executed.
							</p>
						}
						<details class="mt-3">
							<summary class={ "cursor-pointer py-2.5 text-sm font-medium text-cyan-700 hover:text-cyan-800 " + wsFocus }>Review the SQL that will run</summary>
							<div class="mt-2">@sqlBlock(data.Draft.SQL)</div>
						</details>
						<form method="post" action={ templ.SafeURL(migrationURL(data.Nav.ID, data.Draft.ID) + "/execute") } hx-post={ migrationURL(data.Nav.ID, data.Draft.ID) + "/execute" } hx-target="#execution-result" hx-headers={ csrfHeaders(data.Nav.CSRFToken) } hx-disabled-elt="find button" hx-indicator="#execute-progress" hx-on::before-swap={ templ.JSUnsafeFuncCall(errorSwap) } class="mt-4 flex flex-wrap items-center gap-4">
							<input type="hidden" name="csrf_token" value={ data.Nav.CSRFToken }/>
							<input type="hidden" name="expected_revision" value={ itoa64(data.Draft.Revision) }/>
							<input type="hidden" name="expected_version" value={ itoa64(data.CurrentVersion) }/>
							<input type="hidden" name="expected_sql_hash" value={ data.Draft.SQLHash }/>
							<button type="submit" class={ primaryButton }>Execute as { version(data.CurrentVersion + 1) }</button>
							<span id="execute-progress" class="htmx-indicator text-sm text-slate-600" role="status">Executing… this can take up to 10 seconds.</span>
						</form>
					</section>
				}
			</div>
			<div class="min-w-0 flex-[1_1_420px] *:mt-0">
				@PlanPanel(data.Nav.ID, data.Nav.CSRFToken, data.Draft.SQL, data.Nav.CanEdit && data.Draft.AppliedVersion == 0)
			</div>
		</div>
		<section aria-labelledby="attempts-heading" class="mt-10">
			<h2 id="attempts-heading" class={ wsSubhead }>Attempts</h2>
			@attemptTable(data.Nav.ID, data.Attempts, false)
		</section>
	}
}

templ ExecutionResult(r ExecutionResultView) {
	if r.Attempt != nil && r.Attempt.Status == "succeeded" {
		<div role="status" class={ wsSuccess + " mt-6" }>
			<p class="font-semibold">Applied as { version(r.Attempt.AppliedVersion) }.</p>
			<p>{ itoa64(int64(r.Attempt.StatementCount)) } statements committed. <a href={ templ.SafeURL(attemptURL(r.DatabaseID, r.MigrationID, r.Attempt.ID)) } class={ resultLink }>View attempt</a></p>
		</div>
	} else {
		<div role="alert" class={ wsAlert + " mt-6" }>
			if r.Attempt != nil {
				<p class="flex flex-wrap items-center gap-2 font-semibold">@statusBadge(r.Attempt.Status) Candidate { version(r.Attempt.CandidateVersion) }</p>
			}
			<p class="mt-1 break-words">{ r.Message }</p>
			if r.Attempt != nil {
				<p class="mt-1"><a href={ templ.SafeURL(attemptURL(r.DatabaseID, r.MigrationID, r.Attempt.ID)) } class={ resultLink }>View attempt</a> · <a href={ templ.SafeURL(migrationURL(r.DatabaseID, r.MigrationID)) } class={ resultLink }>Reload migration</a></p>
			} else {
				<p class="mt-1"><a href={ templ.SafeURL(migrationURL(r.DatabaseID, r.MigrationID)) } class={ resultLink }>Reload migration</a></p>
			}
		</div>
	}
}

// resultLink keeps links inside tinted result boxes in the box's own color.
const resultLink = "font-medium underline underline-offset-4 hover:no-underline " + wsFocus

templ EditResult(message string) {
	@alert(message)
}

templ AttemptDetail(assets Assets, data AttemptDetailData) {
	@DatabaseShell("Attempt", assets, data.Nav) {
		{{ a := data.Attempt }}
		<a href={ templ.SafeURL(migrationURL(data.Nav.ID, a.MigrationID)) } class={ wsLink + " inline-flex min-h-11 items-center break-words text-sm" }>Back to { a.MigrationTitle }</a>
		<h1 class={ wsHeading + " flex flex-wrap items-center gap-3" }>
			if a.AppliedVersion > 0 {
				Version { itoa64(a.AppliedVersion) }
			} else {
				Candidate version { itoa64(a.CandidateVersion) }
			}
			@statusBadge(a.Status)
		</h1>
		<dl class={ wsPanel + " mt-6 grid gap-x-6 gap-y-4 p-5 text-sm sm:grid-cols-2 lg:grid-cols-3" }>
			<div><dt class="text-slate-600">Executor</dt><dd class="mt-0.5 break-all text-slate-900">{ a.Executor }</dd></div>
			<div><dt class="text-slate-600">Draft revision</dt><dd class="mt-0.5 font-mono text-slate-900">{ itoa64(a.DraftRevision) }</dd></div>
			<div><dt class="text-slate-600">Statements</dt><dd class="mt-0.5 font-mono text-slate-900">{ itoa64(int64(a.StatementCount)) }</dd></div>
			<div><dt class="text-slate-600">Started</dt><dd class="mt-0.5 font-mono text-slate-900">{ a.StartedAt }</dd></div>
			<div><dt class="text-slate-600">Finished</dt><dd class="mt-0.5 font-mono text-slate-900">{ a.FinishedAt }</dd></div>
			<div class="min-w-0"><dt class="text-slate-600">SQL SHA-256</dt><dd class="mt-0.5 break-all font-mono text-xs leading-5 text-slate-900">{ a.SQLHash }</dd></div>
			if a.Reconciled {
				<div class="sm:col-span-2 lg:col-span-3"><dt class="text-slate-600">Reconciliation</dt><dd class="mt-0.5 text-slate-900">Outcome confirmed from the target execution receipt.</dd></div>
			}
		</dl>
		if a.Error != "" {
			<p role="alert" class={ wsAlert + " mt-6 break-words" }>{ a.Error }</p>
		}
		<section aria-labelledby="executed-sql-heading" class={ wsPanel + " mt-6 p-5 sm:p-6" }>
			<h2 id="executed-sql-heading" class={ wsSubhead }>Executed SQL (immutable)</h2>
			<div class="mt-4">@sqlBlock(a.SQL)</div>
		</section>
	}
}

templ SchemaDiff(assets Assets, data SchemaDiffData) {
	@DatabaseShell("Schema diff", assets, data.Nav) {
		<h1 class={ wsHeading }>Schema diff</h1>
		<p class={ wsMuted + " mt-1 max-w-3xl leading-6" }>Compare the live schema with a desired snapshot. Preview never changes the database. Supported additions become a draft you can review and edit before executing.</p>
		<form method="post" action={ templ.SafeURL(schemaDiffURL(data.Nav.ID) + "/preview") } hx-post={ schemaDiffURL(data.Nav.ID) + "/preview" } hx-target="#diff-result" hx-headers={ csrfHeaders(data.Nav.CSRFToken) } hx-disabled-elt="find button" hx-indicator="#diff-progress" hx-on::before-swap={ templ.JSUnsafeFuncCall(errorSwap) } class={ wsPanel + " mt-6 space-y-4 p-5 sm:p-6" }>
			<input type="hidden" name="csrf_token" value={ data.Nav.CSRFToken }/>
			<div class="space-y-1.5">
				<label for="desired" class={ wsLabel }>Desired snapshot (JSON)</label>
				<p id="desired-help" class="text-sm leading-6 text-slate-600">One schema per snapshot. Each column needs name, type and nullable; default is optional. Generation supports CREATE TABLE and ADD COLUMN with common types; other changes are reported as warnings.</p>
				<textarea id="desired" name="desired" rows="18" required spellcheck="false" aria-describedby="desired-help" class={ wsTextarea }>{ data.Desired }</textarea>
			</div>
			<div class="flex flex-wrap items-center gap-4">
				<button type="submit" class={ primaryButton }>Preview changes</button>
				<span id="diff-progress" class="htmx-indicator text-sm text-slate-600" role="status">Reading live schema…</span>
			</div>
		</form>
		<div id="diff-result" aria-live="polite" class="mt-8 space-y-6">
			@SchemaDiffResult(data)
		</div>
	}
}

templ SchemaDiffResult(data SchemaDiffData) {
	@alert(data.Error)
	if p := data.Proposal; p != nil {
		<section aria-labelledby="changes-heading" class={ wsPanel + " p-5 sm:p-6" }>
			<h2 id="changes-heading" class={ wsSubhead + " break-words" }>Changes in schema <span class="font-mono">{ p.Schema }</span></h2>
			if len(p.Changes) == 0 {
				<p class="mt-3 text-sm text-slate-700">The live schema already matches the desired snapshot.</p>
			} else {
				<ul class="mt-3 divide-y divide-slate-100 text-sm">
					for _, c := range p.Changes {
						<li class="flex flex-wrap items-start gap-2 break-words py-2">
							if c.Destructive {
								<span class={ wsChipAmber }>Destructive</span>
							}
							<span class="min-w-0 text-slate-900">{ c.Text }</span>
						</li>
					}
				</ul>
			}
			if len(p.Warnings) > 0 {
				<h3 class="mt-6 text-base font-semibold text-slate-900">Warnings</h3>
				<div class={ wsWarn + " mt-3" }>
					<ul class="list-disc space-y-2 pl-5">
						for _, w := range p.Warnings {
							<li class="break-words">{ w }</li>
						}
					</ul>
				</div>
			}
			if p.SQL != "" {
				<h3 class="mt-6 text-base font-semibold text-slate-900">Candidate SQL</h3>
				<div class="mt-3">@sqlBlock(p.SQL)</div>
				if data.Nav.CanEdit {
					<form method="post" action={ templ.SafeURL(schemaDiffURL(data.Nav.ID) + "/draft") } class="mt-6 flex flex-wrap items-end gap-4 border-t border-slate-200 pt-5">
						<input type="hidden" name="csrf_token" value={ data.Nav.CSRFToken }/>
						<input type="hidden" name="desired" value={ data.Desired }/>
						<input type="hidden" name="source_fingerprint" value={ p.SourceFingerprint }/>
						<div class="min-w-64 flex-1 space-y-1.5"><label for="draft-title" class={ wsLabel }>Draft title</label><input id="draft-title" name="title" type="text" maxlength="200" value={ data.Title } placeholder={ "Schema diff for " + p.Schema } class={ inputClass }/></div>
						<button type="submit" class={ primaryButton }>Use as draft</button>
					</form>
					<p class="mt-3 text-sm text-slate-600">Creates an editable draft only. It is not executed.</p>
				} else {
					<p class="mt-6 text-sm text-slate-600">View + Edit access is required to turn this into a draft.</p>
				}
			} else if len(p.Changes) > 0 {
				<p class="mt-6 text-sm text-slate-600">No SQL was generated for these changes. Write a migration manually if they are intended.</p>
			}
		</section>
	}
}

templ DatabaseError(assets Assets, message string) {
	@Layout("Unable to continue | sqlwise", assets) {
		<div class={ wsPage + " flex items-center justify-center px-4 py-12 sm:px-6" }>
			<main class={ wsPanel + " w-full max-w-xl p-6 sm:p-8" }>
				<h1 class={ wsHeading }>Unable to continue</h1>
				<p role="alert" class={ wsAlert + " mt-4 break-words" }>{ message }</p>
				<a href="/account" class={ wsButton + " mt-6" }>Back to account</a>
			</main>
		</div>
	}
}
