package views

templ Home(assets Assets) {
	@Layout("sqlwise", assets) {
		<div class={ wsPage + " flex flex-col" }>
			<header class="border-b border-slate-200 bg-white">
				<div class="mx-auto flex w-full max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-1 px-4 py-1.5 sm:px-6">
					<a href="/" class={ "inline-flex min-h-11 items-center gap-2 text-base font-bold tracking-tight text-cyan-900 " + wsFocus }>
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><ellipse cx="12" cy="6" rx="7" ry="3"></ellipse><path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6"></path><path d="M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"></path></svg>
						sqlwise
					</a>
					<a href="/login" class={ wsPrimary }>Sign in</a>
				</div>
			</header>
			<main class="mx-auto flex w-full max-w-5xl flex-1 items-center justify-center px-4 py-16 sm:px-6 sm:py-24">
				<div class="flex max-w-2xl flex-col items-center gap-5 text-center">
					<p class="text-sm font-medium text-slate-600">PostgreSQL workspace</p>
					<h1 class="text-5xl font-semibold tracking-tight text-slate-900 sm:text-6xl">sqlwise</h1>
					<p class="text-xl leading-8 text-slate-800">PostgreSQL Management Platform</p>
					<p class="max-w-xl text-base leading-7 text-slate-600">A starting point for managed access, database exploration, and controlled schema changes.</p>
					<a href="/login" class={ wsPrimary + " mt-2"}>Sign in</a>
				</div>
			</main>
			<footer class="border-t border-slate-200 bg-white">
				<p class="mx-auto w-full max-w-5xl px-4 py-5 text-sm text-slate-600 sm:px-6">IF3110 Web Application Development</p>
			</footer>
		</div>
	}
}
