package views

templ ConnectionFeedback(message, problem string) {
	if message != "" {
		<p role="status" aria-live="polite" class={ wsNotice + " mb-5" }>{ message }</p>
	}
	if problem != "" {
		<p role="alert" class={ wsAlert + " mb-5" }>{ problem }</p>
	}
}

templ ConnectionsPage(assets Assets, data ConnectionPageData) {
	@AdminShell("Connections", assets, true) {
		<main>
			<h1 class={ wsHeading }>Connections</h1>
			<p class={ wsMuted + " mt-2 max-w-2xl leading-6" }>Register target databases. Passwords are stored encrypted and never shown again. Grant access to a connection through a group.</p>
			<div id="admin-connections" class="mt-6">
				@ConnectionsFragment(data)
			</div>
		</main>
	}
}

templ ConnectionsFragment(data ConnectionPageData) {
	@ConnectionFeedback(data.Message, data.Error)
	<div class="flex flex-wrap items-start gap-6">
		<section class="min-w-0 flex-[999_1_34rem]" aria-labelledby="registered-connections">
			<h2 id="registered-connections" class={ wsSubhead }>Registered connections</h2>
			if len(data.Connections) == 0 {
				<p class={ wsEmpty + " mt-3" }>No connections are registered yet.</p>
			} else {
				<div class={ wsPanel + " mt-3 overflow-x-auto" }>
					<table class={ wsTable + " min-w-[36rem]" }>
						<thead>
							<tr>
								<th scope="col" class={ wsTh }>Name</th>
								<th scope="col" class={ wsTh }>Engine</th>
								<th scope="col" class={ wsTh }>Address</th>
								<th scope="col" class={ wsTh }>TLS</th>
								<th scope="col" class={ wsTh }>Status</th>
							</tr>
						</thead>
						<tbody>
							for _, row := range data.Connections {
								<tr class="hover:bg-slate-50">
									<td class={ wsTd + " py-1.5" }>
										<a href={ templ.SafeURL(connectionURL(row.ID)) } class={ wsLink + " inline-flex min-h-11 items-center break-all font-medium" }>{ row.Name }</a>
									</td>
									<td class={ wsTd + " py-3.5" }><span class={ wsChip }>{ row.DBMS }</span></td>
									<td class={ wsTd + " py-3.5 break-all font-mono text-[13px] text-slate-800" }>{ row.Username + "@" + row.Address }</td>
									<td class={ wsTd + " py-3.5 whitespace-nowrap font-mono text-[13px] text-slate-700" }>{ row.TLS }</td>
									<td class={ wsTd + " py-3.5" }>
										if row.Active {
											<span class={ wsChipGreen }>Active</span>
										} else {
											<span class={ wsChip }>Disabled</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
		<section class={ wsPanel + " min-w-0 flex-[1_1_20rem] p-5" } aria-labelledby="create-connection">
			<h2 id="create-connection" class={ wsSubhead }>Register connection</h2>
			<form method="post" action="/admin/databases" hx-post="/admin/databases" hx-target="#admin-connections" hx-swap="innerHTML" hx-headers={ csrfHeaders(data.CSRFToken) } class="mt-4 space-y-4">
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				@ConnectionFields(data.Form)
				<button type="submit" class={ wsPrimary + " w-full" }>Register connection</button>
			</form>
		</section>
	</div>
}

templ ConnectionFields(form ConnectionForm) {
	<div class="space-y-1.5">
		<label for="connection-name" class={ wsLabel }>Display name</label>
		<input id="connection-name" name="name" value={ form.Name } required maxlength="128" class={ wsInput }/>
	</div>
	<div class="space-y-1.5">
		<label for="connection-dbms" class={ wsLabel }>Database type</label>
		<select id="connection-dbms" name="dbms" required class={ wsSelect + " w-full" }>
			<option value="postgresql" selected?={ form.DBMS != "mysql" }>PostgreSQL</option>
			<option value="mysql" selected?={ form.DBMS == "mysql" }>MySQL (bonus; migrations are not atomic)</option>
		</select>
	</div>
	<div class="grid gap-4 sm:grid-cols-[minmax(0,1fr)_7rem]">
		<div class="space-y-1.5">
			<label for="connection-host" class={ wsLabel }>Host</label>
			<input id="connection-host" name="host" value={ form.Host } required autocomplete="off" class={ wsInput + " font-mono" }/>
		</div>
		<div class="space-y-1.5">
			<label for="connection-port" class={ wsLabel }>Port</label>
			<input id="connection-port" name="port" value={ form.Port } required inputmode="numeric" class={ wsInput + " font-mono" }/>
		</div>
	</div>
	<div class="space-y-1.5">
		<label for="connection-database" class={ wsLabel }>Database name</label>
		<input id="connection-database" name="database" value={ form.Database } required autocomplete="off" class={ wsInput + " font-mono" }/>
	</div>
	<div class="space-y-1.5">
		<label for="connection-username" class={ wsLabel }>Username</label>
		<input id="connection-username" name="username" value={ form.Username } required autocomplete="off" class={ wsInput + " font-mono" }/>
	</div>
	<div class="space-y-1.5">
		<label for="connection-password" class={ wsLabel }>Password</label>
		if form.Existing {
			<input id="connection-password" name="password" type="password" autocomplete="new-password" aria-describedby="connection-password-hint" class={ wsInput }/>
			<p id="connection-password-hint" class={ wsMuted }>Leave blank to keep the current password.</p>
		} else {
			<input id="connection-password" name="password" type="password" autocomplete="new-password" class={ wsInput }/>
		}
	</div>
	<label class="flex min-h-11 cursor-pointer items-start gap-3 py-1 text-sm text-slate-900">
		<input type="checkbox" name="analyze_sandbox" checked?={ form.Sandbox } class={ "mt-0.5 size-4 shrink-0 accent-cyan-700 " + wsFocus }/>
		<span class="font-medium">Analyze sandbox <span class="mt-0.5 block font-normal leading-6 text-slate-600">PostgreSQL only. Lets editors run EXPLAIN ANALYZE on SELECT statements here. Use an isolated database and a read-only user.</span></span>
	</label>
	<div class="space-y-1.5">
		<label for="connection-tls" class={ wsLabel }>TLS</label>
		<select id="connection-tls" name="tls" required class={ wsSelect + " w-full" }>
			<option value="verify-full" selected?={ form.TLS == "verify-full" || form.TLS == "" }>Verify certificate and host</option>
			<option value="require" selected?={ form.TLS == "require" }>Encrypt without verification</option>
			<option value="disable" selected?={ form.TLS == "disable" }>Disabled</option>
		</select>
	</div>
}

templ ConnectionEditPage(assets Assets, data ConnectionPageData) {
	@AdminShell("Edit connection", assets, true) {
		<main>
			<a class={ wsLink + " inline-flex min-h-11 items-center text-sm" } href="/admin/databases">Connections</a>
			<div class="mt-1 flex flex-wrap items-center gap-2.5">
				<h1 class={ wsHeading + " break-words" }>{ data.Form.Name }</h1>
				if data.Form.Sandbox {
					<span class={ wsChipAmber }>Analyze sandbox</span>
				}
			</div>
			<div id="connection-detail" class="mt-6">
				@ConnectionDetailFragment(data)
			</div>
		</main>
	}
}

templ ConnectionDetailFragment(data ConnectionPageData) {
	@ConnectionFeedback(data.Message, data.Error)
	<div class="flex flex-wrap items-start gap-6">
		<section class={ wsPanel + " min-w-0 flex-[999_1_26rem] p-5" } aria-labelledby="edit-connection">
			<h2 id="edit-connection" class={ wsSubhead }>Connection settings</h2>
			<p class={ wsMuted + " mt-2 leading-6" }>A connection with migration history keeps its database type, host, port and database name; register a new connection for a different database.</p>
			<form method="post" action={ templ.SafeURL(connectionURL(data.Form.ID)) } hx-post={ templ.SafeURL(connectionURL(data.Form.ID)) } hx-target="#connection-detail" hx-swap="innerHTML" hx-headers={ csrfHeaders(data.CSRFToken) } class="mt-5 space-y-4">
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				@ConnectionFields(data.Form)
				<button type="submit" class={ wsPrimary + " w-full" }>Save changes</button>
			</form>
		</section>
		<div class="min-w-0 flex-[1_1_20rem] space-y-6">
			<section class={ wsPanel + " p-5" } aria-labelledby="test-connection">
				<h2 id="test-connection" class={ wsSubhead }>Test connection</h2>
				<form method="post" action={ templ.SafeURL(connectionURL(data.Form.ID) + "/test") } hx-post={ templ.SafeURL(connectionURL(data.Form.ID) + "/test") } hx-target="#connection-test" hx-swap="innerHTML" hx-headers={ csrfHeaders(data.CSRFToken) } class="mt-4">
					<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
					<button type="submit" class={ wsButton }>Test saved connection</button>
				</form>
				<div id="connection-test" class="mt-4">
					@ConnectionTestResult(data.Test)
				</div>
			</section>
			<section class={ wsPanel + " p-5" } aria-labelledby="connection-status">
				<h2 id="connection-status" class={ wsSubhead }>Status</h2>
				<form method="post" action={ templ.SafeURL(connectionURL(data.Form.ID) + "/active") } hx-post={ templ.SafeURL(connectionURL(data.Form.ID) + "/active") } hx-target="#connection-detail" hx-swap="innerHTML" hx-headers={ csrfHeaders(data.CSRFToken) } class="mt-4 flex flex-wrap items-center justify-between gap-3">
					<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
					if data.Form.Active {
						<p class="min-w-0 flex-[1_1_12rem] text-sm leading-6 text-slate-700">Active. Disabling keeps grants and migration history and signs out users who can access it.</p>
						<input type="hidden" name="active" value="false"/>
						<button type="submit" class={ wsButton }>Disable</button>
					} else {
						<p class="min-w-0 flex-[1_1_12rem] text-sm leading-6 text-slate-700">Disabled. Nobody can open this database until it is enabled.</p>
						<input type="hidden" name="active" value="true"/>
						<button type="submit" class={ wsPrimary }>Enable</button>
					}
				</form>
			</section>
			<section class={ wsPanel + " p-5" } aria-labelledby="connection-capabilities">
				<h2 id="connection-capabilities" class={ wsSubhead }>Capabilities</h2>
				<ul class="mt-3 divide-y divide-slate-100 text-sm">
					for _, capability := range data.Capabilities {
						<li class="flex flex-wrap items-center justify-between gap-3 py-2">
							<span class="text-slate-800">{ capability.Name }</span>
							if capability.Supported {
								<span class={ wsChipGreen }>Supported</span>
							} else {
								<span class={ wsChip }>Unsupported</span>
							}
						</li>
					}
				</ul>
			</section>
			if data.ReceiptSQL != "" {
				<section class={ wsPanel + " p-5" } aria-labelledby="receipt-setup">
					<h2 id="receipt-setup" class={ wsSubhead }>Migration receipt setup</h2>
					<p class={ wsMuted + " mt-2 leading-6" }>Run once in the target database as a role other than <span class="font-mono text-slate-900">{ data.Form.Username }</span>, so migrations cannot change their own receipts. The user also needs the privileges its migrations use.</p>
					<pre class="mt-4 overflow-x-auto rounded-lg border border-slate-200 bg-slate-50 p-4 font-mono text-xs leading-5 text-slate-900"><code>{ data.ReceiptSQL }</code></pre>
				</section>
			}
		</div>
	</div>
}

templ ConnectionTestResult(test ConnectionTest) {
	if test.Ran && test.OK {
		<p role="status" class={ wsSuccess }>{ test.Message }</p>
	} else if test.Ran {
		<p role="alert" class={ wsAlert }>{ test.Message }</p>
	}
}
