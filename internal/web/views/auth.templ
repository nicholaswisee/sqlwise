package views

templ AuthShell(title string, assets Assets) {
	@Layout(title + " | sqlwise", assets) {
		<main class="mx-auto flex min-h-screen w-full max-w-md flex-col justify-center px-6 py-12">
			<a href="/" class="mb-8 w-fit rounded-lg py-3 text-sm font-semibold tracking-widest text-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">sqlwise</a>
			<section aria-labelledby="auth-title" class="rounded-2xl border border-slate-800 bg-slate-900 p-6 sm:p-8">
				<h1 id="auth-title" class="text-3xl font-semibold tracking-tight">{ title }</h1>
				{ children... }
			</section>
		</main>
	}
}

templ Login(assets Assets, username string, csrf string, message string) {
	@AuthShell("Sign in", assets) {
		<p class="mt-3 text-sm leading-6 text-slate-400">Use the account provided by your platform administrator.</p>
		<p id="login-error" role="alert" hidden?={ message == "" } class="mt-6 rounded-lg bg-rose-950 p-4 text-sm leading-6 text-rose-200">{ message }</p>
		<form method="post" action="/login" class="mt-8 space-y-6">
			<input type="hidden" name="csrf_token" value={ csrf }/>
			<div class="space-y-2">
				<label for="username" class="block text-sm font-medium text-slate-200">Username</label>
				<input id="username" name="username" type="text" value={ username } autocomplete="username" autocapitalize="none" spellcheck="false" required maxlength="64" aria-describedby="login-error" class="min-h-12 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-3 text-base text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"/>
			</div>
			<div class="space-y-2">
				<label for="password" class="block text-sm font-medium text-slate-200">Password</label>
				<input id="password" name="password" type="password" autocomplete="current-password" required maxlength="128" aria-describedby="login-error" class="min-h-12 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-3 text-base text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"/>
			</div>
			<button type="submit" class="min-h-12 w-full rounded-lg bg-cyan-400 px-4 py-3 text-sm font-semibold text-slate-950 hover:bg-cyan-300 active:bg-cyan-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">Sign in</button>
		</form>
	}
}

templ Account(assets Assets, username string, csrf string) {
	@AuthShell("You are signed in", assets) {
		<p class="mt-4 break-words text-sm leading-6 text-slate-200">Signed in as <strong>{ username }</strong>.</p>
		<form method="post" action="/logout" class="mt-8">
			<input type="hidden" name="csrf_token" value={ csrf }/>
			<button type="submit" class="min-h-12 w-full rounded-lg bg-cyan-400 px-4 py-3 text-sm font-semibold text-slate-950 hover:bg-cyan-300 active:bg-cyan-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">Sign out</button>
		</form>
	}
}

templ AuthError(assets Assets, message string) {
	@AuthShell("Unable to continue", assets) {
		<p role="alert" class="mt-4 text-sm leading-6 text-rose-200">{ message }</p>
		<a href="/login" class="mt-6 inline-block rounded-lg py-3 text-sm text-cyan-300 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">Return to sign in</a>
	}
}
