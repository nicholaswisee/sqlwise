package views

templ AuthShell(title string, assets Assets) {
	@Layout(title + " | sqlwise", assets) {
		<div class="flex min-h-screen flex-col bg-slate-100 text-slate-900 lg:flex-row">
			<aside aria-label="About sqlwise" class="border-b border-slate-200 bg-white px-4 py-1.5 sm:px-6 lg:flex lg:w-[44%] lg:max-w-2xl lg:flex-col lg:gap-12 lg:border-r lg:border-b-0 lg:px-14 lg:py-12">
				<a href="/" class={ "inline-flex min-h-11 w-fit items-center gap-2 text-base font-bold tracking-tight text-cyan-900 lg:text-lg " + wsFocus }>
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><ellipse cx="12" cy="6" rx="7" ry="3"></ellipse><path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6"></path><path d="M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"></path></svg>
					sqlwise
				</a>
				<div class="hidden max-w-lg space-y-5 lg:my-auto lg:block">
					<p class="text-4xl leading-tight font-semibold tracking-tight text-slate-900">Every schema change, in order, with a record of what ran.</p>
					<p class="text-lg leading-8 text-slate-600">Browse PostgreSQL and MySQL databases, write migrations, check their query plans and run them with your group's permissions.</p>
				</div>
			</aside>
			<main class="flex flex-1 items-center justify-center px-4 py-10 sm:px-6 sm:py-16">
				<section aria-labelledby="auth-title" class={ wsPanel + " w-full max-w-md p-6 sm:p-8" }>
					<h1 id="auth-title" class={ wsHeading }>{ title }</h1>
					{ children... }
				</section>
			</main>
		</div>
	}
}

templ Login(assets Assets, username string, csrf string, message string) {
	@AuthShell("Sign in", assets) {
		<p class={ wsMuted + " mt-2 leading-6" }>Use the account provided by your platform administrator.</p>
		<p id="login-error" role="alert" hidden?={ message == "" } class={ wsAlert + " mt-6" }>{ message }</p>
		<form method="post" action="/login" class="mt-6 space-y-5">
			<input type="hidden" name="csrf_token" value={ csrf }/>
			<div class="space-y-1.5">
				<label for="username" class={ wsLabel }>Username</label>
				<input id="username" name="username" type="text" value={ username } autocomplete="username" autocapitalize="none" spellcheck="false" required maxlength="64" aria-describedby="login-error" class={ wsInput }/>
			</div>
			<div class="space-y-1.5">
				<label for="password" class={ wsLabel }>Password</label>
				<input id="password" name="password" type="password" autocomplete="current-password" required maxlength="128" aria-describedby="login-error" class={ wsInput }/>
			</div>
			<button type="submit" class={ wsPrimary + " w-full" }>Sign in</button>
		</form>
	}
}

templ Account(assets Assets, username string, csrf string) {
	@AuthShell("You are signed in", assets) {
		<p class="mt-3 break-words text-sm leading-6 text-slate-700">Signed in as <strong class="font-semibold text-slate-900">{ username }</strong>.</p>
		@SessionStatus()
		@LogoutForm(csrf)
	}
}

templ SessionStatus() {
	<div id="session-status" role="status" aria-live="polite" class="mt-6 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-slate-200 bg-slate-50 py-2 pr-2 pl-4 text-sm text-slate-800">
		<span class="inline-flex items-center gap-2"><span aria-hidden="true" class="size-2 rounded-full bg-emerald-600"></span>Session active</span>
		<a href="/account" hx-get="/account/session" hx-target="#session-status" hx-swap="outerHTML" class={ wsButton }>Refresh session</a>
	</div>
}

templ LogoutForm(csrf string) {
	<form method="post" action="/logout" hx-post="/logout" hx-headers={ csrfHeaders(csrf) } class="mt-6">
		<input type="hidden" name="csrf_token" value={ csrf }/>
		<button type="submit" class={ wsButton + " w-full" }>Sign out</button>
	</form>
}

templ AuthError(assets Assets, message string) {
	@AuthShell("Unable to continue", assets) {
		<p role="alert" class={ wsAlert + " mt-4" }>{ message }</p>
		<a href="/login" class={ wsLink + " mt-4 inline-flex min-h-11 items-center text-sm" }>Return to sign in</a>
	}
}
