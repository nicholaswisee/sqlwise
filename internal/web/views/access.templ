package views

templ AccessAdmin(assets Assets, data AccessAdminData) {
	@Layout("Access control | sqlwise", assets) {
		<main class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
			<header class="mb-8 flex flex-wrap items-center justify-between gap-4">
				<a href="/account" class="rounded-lg py-3 text-sm font-medium text-cyan-300 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">Back to account</a>
				<p class="break-words text-sm text-slate-400">Signed in as <strong class="text-slate-200">{ data.Username }</strong></p>
			</header>
			<h1 class="text-3xl font-semibold tracking-tight">Access control</h1>
			<p class="mt-3 max-w-3xl text-sm leading-6 text-slate-400">Create regular users, organize them into groups, and assign group access to registered targets. Platform administrators manage access but do not receive target access automatically.</p>
			if data.Message != "" {
				<p role="status" class="mt-6 rounded-lg border border-slate-800 bg-slate-900 p-4 text-sm text-slate-200">{ data.Message }</p>
			}
			if data.Error != "" {
				<p role="alert" class="mt-4 rounded-lg bg-rose-950 p-4 text-sm text-rose-200">{ data.Error }</p>
			}
			<div class="mt-8 grid gap-6 lg:grid-cols-2">
				<section aria-labelledby="users-heading" class="min-w-0 rounded-2xl border border-slate-800 bg-slate-900 p-5 sm:p-6">
					<h2 id="users-heading" class="text-xl font-semibold">Users</h2>
					<form method="post" action="/admin/access/users" class="mt-5 space-y-4">
						<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
						<div class="space-y-2"><label for="new-username" class="block text-sm font-medium text-slate-200">Username</label><input id="new-username" name="username" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" required maxlength="64" class="min-h-12 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-3 text-base text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"/></div>
						<div class="space-y-2"><label for="new-password" class="block text-sm font-medium text-slate-200">Password</label><input id="new-password" name="password" type="password" autocomplete="new-password" required maxlength="128" class="min-h-12 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-3 text-base text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"/></div>
						<button type="submit" class="min-h-12 w-full rounded-lg bg-cyan-400 px-4 py-3 text-sm font-semibold text-slate-950 hover:bg-cyan-300 active:bg-cyan-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">Create regular user</button>
					</form>
					if len(data.Users) == 0 {
						<p class="mt-6 text-sm text-slate-400">No users yet.</p>
					}
					if len(data.Users) > 0 {
						<ul class="mt-6 divide-y divide-slate-800">
							for _, user := range data.Users {
								<li class="flex flex-wrap items-center justify-between gap-3 py-4 first:pt-0 last:pb-0">
									<span class="break-all text-sm text-slate-200">{ user.Username }</span>
									if !user.Active {
										<span class="text-sm text-slate-400">Inactive</span>
									}
									<form method="post" action="/admin/access/revoke-sessions"><input type="hidden" name="csrf_token" value={ data.CSRFToken }/><input type="hidden" name="user_id" value={ user.ID }/><button type="submit" class="min-h-11 rounded-lg border border-slate-700 px-3 py-2 text-sm text-slate-200 hover:border-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">Revoke sessions</button></form>
								</li>
							}
						</ul>
					}
				</section>
				<section aria-labelledby="groups-heading" class="min-w-0 rounded-2xl border border-slate-800 bg-slate-900 p-5 sm:p-6">
					<h2 id="groups-heading" class="text-xl font-semibold">Groups</h2>
					<form method="post" action="/admin/access/groups" class="mt-5 space-y-4">
						<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
						<div class="space-y-2"><label for="new-group" class="block text-sm font-medium text-slate-200">Group name</label><input id="new-group" name="name" type="text" required maxlength="64" class="min-h-12 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-3 text-base text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"/></div>
						<button type="submit" class="min-h-12 w-full rounded-lg bg-cyan-400 px-4 py-3 text-sm font-semibold text-slate-950 hover:bg-cyan-300 active:bg-cyan-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">Create group</button>
					</form>
					if len(data.Groups) == 0 {
						<p class="mt-6 text-sm text-slate-400">No groups yet.</p>
					}
					if len(data.Groups) > 0 {
						<ul class="mt-6 space-y-2">
							for _, group := range data.Groups {
								<li class="break-words rounded-lg border border-slate-800 px-3 py-3 text-sm text-slate-200">{ group.Name }</li>
							}
						</ul>
					}
				</section>
				<section aria-labelledby="memberships-heading" class="min-w-0 rounded-2xl border border-slate-800 bg-slate-900 p-5 sm:p-6">
					<h2 id="memberships-heading" class="text-xl font-semibold">Group memberships</h2>
					<form method="post" action="/admin/access/memberships" class="mt-5 space-y-4">
						<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
						<div class="space-y-2"><label for="membership-user" class="block text-sm font-medium text-slate-200">User</label><select id="membership-user" name="user_id" required class="min-h-12 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 text-base text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"><option value="">Choose a user</option>
							for _, user := range data.Users {
								<option value={ user.ID }>{ user.Username }</option>
							}
						</select></div>
						<div class="space-y-2"><label for="membership-group" class="block text-sm font-medium text-slate-200">Group</label><select id="membership-group" name="group_id" required class="min-h-12 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 text-base text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"><option value="">Choose a group</option>
							for _, group := range data.Groups {
								<option value={ group.ID }>{ group.Name }</option>
							}
						</select></div>
						<button type="submit" class="min-h-12 w-full rounded-lg bg-cyan-400 px-4 py-3 text-sm font-semibold text-slate-950 hover:bg-cyan-300 active:bg-cyan-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">Add membership</button>
					</form>
					if len(data.Memberships) == 0 {
						<p class="mt-6 text-sm text-slate-400">No memberships yet.</p>
					}
					if len(data.Memberships) > 0 {
						<ul class="mt-6 divide-y divide-slate-800">
							for _, membership := range data.Memberships {
								<li class="flex min-w-0 flex-wrap items-center justify-between gap-3 py-3"><span class="min-w-0 break-all text-sm text-slate-200">{ membership.Username } <span class="text-slate-400">in</span> { membership.GroupName }</span><form method="post" action="/admin/access/memberships/remove"><input type="hidden" name="csrf_token" value={ data.CSRFToken }/><input type="hidden" name="user_id" value={ membership.UserID }/><input type="hidden" name="group_id" value={ membership.GroupID }/><button type="submit" class="min-h-11 rounded-lg border border-slate-700 px-3 py-2 text-sm text-slate-200 hover:border-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">Remove membership</button></form></li>
							}
						</ul>
					}
				</section>
				<section aria-labelledby="grants-heading" class="min-w-0 rounded-2xl border border-slate-800 bg-slate-900 p-5 sm:p-6">
					<h2 id="grants-heading" class="text-xl font-semibold">Target access</h2>
					<form method="post" action="/admin/access/grants" class="mt-5 space-y-4">
						<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
						<div class="space-y-2"><label for="grant-group" class="block text-sm font-medium text-slate-200">Group</label><select id="grant-group" name="group_id" required class="min-h-12 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 text-base text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"><option value="">Choose a group</option>
							for _, group := range data.Groups {
								<option value={ group.ID }>{ group.Name }</option>
							}
						</select></div>
						<div class="space-y-2"><label for="grant-database" class="block text-sm font-medium text-slate-200">Registered target</label><select id="grant-database" name="database_id" required class="min-h-12 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 text-base text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"><option value="">Choose a registered target</option>
							for _, database := range data.Databases {
								<option value={ database.ID }>{ database.Name }</option>
							}
						</select></div>
						<div class="space-y-2"><label for="grant-permission" class="block text-sm font-medium text-slate-200">Permission</label><select id="grant-permission" name="permission" required class="min-h-12 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 text-base text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"><option value="view">View</option><option value="edit">Edit</option></select></div>
						<button type="submit" class="min-h-12 w-full rounded-lg bg-cyan-400 px-4 py-3 text-sm font-semibold text-slate-950 hover:bg-cyan-300 active:bg-cyan-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">Save target access</button>
					</form>
					if len(data.Databases) == 0 {
						<p class="mt-6 text-sm leading-6 text-slate-400">No registered targets yet. Connection registration is not available in this slice.</p>
					}
					if len(data.Grants) == 0 {
						<p class="mt-3 text-sm text-slate-400">No target access grants yet.</p>
					}
					if len(data.Grants) > 0 {
						<ul class="mt-6 divide-y divide-slate-800">
							for _, grant := range data.Grants {
								<li class="flex min-w-0 flex-wrap items-center justify-between gap-3 py-3"><span class="min-w-0 break-all text-sm text-slate-200">{ grant.GroupName } <span class="text-slate-400">can</span> { grant.Permission } <span class="text-slate-400">on</span> { grant.DatabaseName }</span><form method="post" action="/admin/access/grants/remove"><input type="hidden" name="csrf_token" value={ data.CSRFToken }/><input type="hidden" name="group_id" value={ grant.GroupID }/><input type="hidden" name="database_id" value={ grant.DatabaseID }/><button type="submit" class="min-h-11 rounded-lg border border-slate-700 px-3 py-2 text-sm text-slate-200 hover:border-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">Remove grant</button></form></li>
							}
						</ul>
					}
				</section>
			</div>
		</main>
	}
}

templ AccessAccount(assets Assets, data AccessAccountData) {
	@AuthShell("Your account", assets) {
		<p class="mt-4 break-words text-sm leading-6 text-slate-200">Signed in as <strong>{ data.Username }</strong>.</p>
		if data.IsPlatformAdmin {
			<a href="/admin/access" class="mt-4 inline-block rounded-lg py-3 text-sm text-cyan-300 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">Manage access</a>
		}
		<section aria-labelledby="account-targets" class="mt-8">
			<h2 id="account-targets" class="text-lg font-semibold">Your database access</h2>
			if len(data.Databases) == 0 {
				<p class="mt-3 text-sm leading-6 text-slate-400">No database access has been assigned to your account.</p>
			}
			if len(data.Databases) > 0 {
				<ul class="mt-4 divide-y divide-slate-800">
					for _, database := range data.Databases {
						<li class="flex flex-wrap items-center justify-between gap-3 py-4"><span class="break-words text-sm text-slate-200">{ database.Name }</span><span class="rounded-lg border border-slate-700 px-3 py-2 text-sm text-cyan-300">{ database.Permission }</span></li>
					}
				</ul>
			}
		</section>
		@LogoutForm(data.CSRFToken)
	}
}
