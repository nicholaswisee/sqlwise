FROM golang:1.27.1 AS app
WORKDIR /app
ENV CGO_ENABLED=1
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN go tool templ generate \
    && go build -o /usr/local/bin/sqlwise ./cmd/server \
    && go build -o /usr/local/bin/sqlwise-admin ./cmd/admin
CMD ["sqlwise"]

FROM node:24-bookworm-slim AS frontend
WORKDIR /app
RUN npm install --global vite-plus@1.3.0
COPY package.json pnpm-lock.yaml ./
RUN vp install --frozen-lockfile
COPY vite.config.ts tsconfig.json ./
COPY web ./web
CMD ["vp", "dev", "--host", "0.0.0.0"]
