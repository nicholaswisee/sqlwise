{
  "name": "sqlwise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "spa:dev": "vp -C web/spa dev",
    "spa:check": "tsc -p web/spa/tsconfig.json",
    "spa:build": "vp -C web/spa build",
    "spa:test": "vp test --config web/spa/vitest.config.ts",
    "spa:e2e": "playwright test --config web/spa/playwright.config.ts",
    "go:generate": "go tool templ generate",
    "go:test": "go test ./...",
    "go:build": "go build -o bin/sqlwise ./cmd/server",
    "build:all": "vp run go:generate && vp build && vp run go:build",
    "ci": "vp check && vp run go:generate && vp run go:test && vp build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "htmx.org": "^2.0.11",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  }
}
